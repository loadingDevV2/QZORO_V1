# Public Supabase project settings. These are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only encryption key for stored provider keys.
# Generate with: openssl rand -base64 32
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Optional deployment-wide provider keys. A key saved in Settings overrides these.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_GO_API_KEY=

# Optional. Per-provider-call timeout. Defaults to 55s; also capped by
# ANALYSIS_BUDGET_MS so a single review always finishes within the function limit.
PROVIDER_TIMEOUT_MS=55000

# Optional. Total provider work allowed per analysis, in ms. Keep it below the
# route's maxDuration so the request can finish cleanly. Defaults to 50s.
# ANALYSIS_BUDGET_MS=50000

# Optional. IANA timezone used for daily/weekly limits and default trade dates.
# Use the desk's timezone, e.g. Europe/London or Asia/Bangkok. Defaults to UTC.
DESK_TIMEZONE=UTC
